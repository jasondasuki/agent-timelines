{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\" python3 -m agent_timelines hook --via plugin 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
